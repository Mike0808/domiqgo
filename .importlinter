; Контракты границ Domiq — шаг A2 плана миграции
; docs/architecture/04-migration-plan.md
;
; Разделение с tests/architecture/:
;   здесь          — слои внутри модуля и чистота domain от фреймворков;
;   в тестах       — запрет импортировать внутренности чужого модуля
;                    (правило переборное, его удобнее выразить обходом дерева).
;
; Приложение billing/ ни в одном контракте НЕ является источником: оно объявлено
; устаревающим слоем и проверяется только после расформирования (§2 плана
; миграции). Но в root_packages оно перечислено, и по двум причинам:
;
;   1. Контракт no-legacy-app-from-modules запрещает импортировать `billing`.
;      Модуля, которого нет в графе, запретить нельзя — контракт становится
;      недействительным, и весь прогон падает.
;   2. `include_external_packages` добавляет в граф только те внешние пакеты,
;      которые кто-то из корневых импортирует. Пока modules/ пуст, django и
;      allauth не импортирует никто, и contract domain-purity ссылался бы на
;      несуществующие модули. Импорты billing/ вводят их в граф.
;
; Верхнеуровневый `billing` и `modules.billing` — в графе разные модули; на
; совпадение имён (оно же коллизия app_label, см. modules/README.md) контракты
; не реагируют.
;
; Celery в forbidden_modules отсутствует: в проекте его нет, ставить не
; планируется, и упоминание несуществующего пакета делает контракт
; недействительным. Запрет сохранён в tests/architecture/test_domain_purity.py,
; где проверка текстовая и наличия пакета не требует.

[importlinter]
root_packages =
    modules
    billing
include_external_packages = True

; --------------------------------------------------------------------------
[importlinter:contract:layers]
name = Слои внутри модуля: api → application → domain
type = layers
layers =
    api
    application
    domain
containers =
    modules.identity
    modules.properties
    modules.tenancy
    modules.metering
    modules.tariffs
    modules.billing
    modules.payments
    modules.notifications
    modules.reporting

; --------------------------------------------------------------------------
[importlinter:contract:domain-purity]
name = domain не знает о фреймворках
type = forbidden
source_modules =
    modules.identity.domain
    modules.properties.domain
    modules.tenancy.domain
    modules.metering.domain
    modules.tariffs.domain
    modules.billing.domain
    modules.payments.domain
    modules.notifications.domain
    modules.reporting.domain
forbidden_modules =
    django
    allauth
    requests

; Контракта «ORM только в infrastructure» здесь нет и быть не может:
; import-linter отвергает `django.db` — «subpackages of external packages are
; not valid», проверено прогоном 31603387708. Запретить `django` целиком было
; бы другим, более строгим правилом, чем принятое (3.2 запрещает ORM, а не
; фреймворк), и вводить его молча нельзя. Правило проверяется
; tests/architecture/test_domain_purity.py, где анализ текстовый и это
; ограничение не действует.
;
; --------------------------------------------------------------------------
; Правило 3.5: оркестрация работает через порты, иначе подменить хранилище
; в тесте невозможно. Заодно покрывает случай, когда domain или application
; тянут infrastructure чужого модуля.
[importlinter:contract:application-does-not-touch-infrastructure]
name = domain и application не импортируют infrastructure
type = forbidden
source_modules =
    modules.identity.domain
    modules.identity.application
    modules.properties.domain
    modules.properties.application
    modules.tenancy.domain
    modules.tenancy.application
    modules.metering.domain
    modules.metering.application
    modules.tariffs.domain
    modules.tariffs.application
    modules.billing.domain
    modules.billing.application
    modules.payments.domain
    modules.payments.application
    modules.notifications.domain
    modules.notifications.application
    modules.reporting.domain
    modules.reporting.application
forbidden_modules =
    modules.identity.infrastructure
    modules.properties.infrastructure
    modules.tenancy.infrastructure
    modules.metering.infrastructure
    modules.tariffs.infrastructure
    modules.billing.infrastructure
    modules.payments.infrastructure
    modules.notifications.infrastructure
    modules.reporting.infrastructure

; --------------------------------------------------------------------------
[importlinter:contract:no-legacy-app-from-modules]
name = Модули не тянут устаревающее приложение billing
type = forbidden
source_modules =
    modules
forbidden_modules =
    billing
