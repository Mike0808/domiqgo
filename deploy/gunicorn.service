[Unit]
Description=domiqgo gunicorn (Django utility billing portal)
After=network.target
# If PostgreSQL runs on the same host, wait for it:
# After=network.target postgresql.service
# Wants=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/srv/domiqgo
# Django reads /srv/domiqgo/.env itself via python-dotenv (load_dotenv in
# config/settings.py), so no EnvironmentFile is needed here.
ExecStart=/srv/domiqgo/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
