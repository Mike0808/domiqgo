# Production environment for domiqgo.
# Docker: copy to .env next to docker-compose.yml (env_file of the web service).
# Bare metal: copy to /srv/domiqgo/.env.
# NEVER commit the real .env — it holds secrets. (.env is git-ignored.)

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string

# Production mode: turns on secure cookies + HSTS, turns off debug pages.
DEBUG=0

# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=domiq-ufa.ru

# Origins (scheme required) trusted for CSRF-protected POST forms.
CSRF_TRUSTED_ORIGINS=https://domiq-ufa.ru

# Database adapter. The MVP runs SQLite (fits the 1 CPU / 1 GB VPS); the
# Docker stack stores it on the persistent volume automatically.
DB_ENGINE=sqlite

# To move to PostgreSQL later: set DB_ENGINE=postgres, fill these in, and
# install the extra (uv sync --extra postgres).
#DB_NAME=domiqgo
#DB_USER=domiqgo
#DB_PASSWORD=replace-with-db-password
#DB_HOST=localhost
#DB_PORT=5432

# Telegram receipt bot (Plan 2). Token from @BotFather; secret is any long random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OAuth login (additive to password login). Each provider's console:
#   Yandex: https://oauth.yandex.ru/client/new
#   VK:     https://id.vk.com/business/go
#   Gosuslugi (ESIA): requires org accreditation via Rostelecom/Minsvyaz —
#     see docs/superpowers/specs/2026-07-27-oauth-login-design.md
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=
ESIA_BASE_URL=https://esia-portal1.test.gosuslugi.ru
