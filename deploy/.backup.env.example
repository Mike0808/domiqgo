# Yandex Disk backup credentials for deploy/backup-yadisk.sh.
# Copy to /srv/domiqgo/.backup.env and chmod 600 — this file holds a password.
# NEVER commit the real file.

# Your Yandex login (the part before @yandex.ru, or the full email).
YADISK_USER=your-login

# App password, NOT your account password:
# id.yandex.ru -> Безопасность -> Пароли приложений -> «Файлы (WebDAV)».
YADISK_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# How many newest archives to keep on the Disk (older ones are deleted).
KEEP=14
